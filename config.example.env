# ============================================================
# Infrastructure Configuration
# ============================================================
# Copy this file to config.env and update the values.
# DO NOT COMMIT actual secrets to git!

# --- Environment ---
ENVIRONMENT=dev

# --- Docker ---
# Runtime: colima (macOS default), docker (Linux/Ubuntu default)
# Leave empty to auto-detect
DOCKER_RUNTIME=

# --- GitHub Access ---
# Required for ArgoCD to sync private repos (if applicable) or access token
GITHUB_TOKEN=

# --- Docker Registry ---
# Required for pulling private images
DOCKER_REGISTRY_SERVER=https://index.docker.io/v1/
DOCKER_USERNAME=
DOCKER_PASSWORD=
DOCKER_EMAIL=

# --- Database ---
POSTGRES_PASSWORD=password

# --- Monitoring ---
# SigNoz UI accessible at http://localhost:9000/signoz
