# ============================================================
# DISABLED: Victoria Metrics for Caretta — not needed without Caretta.
# Re-enable alongside monitoring-caretta.yaml.disabled on a real cluster.
# ============================================================
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: dev-monitoring-caretta-vm
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "3"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
  labels:
    environment: dev
    domain: monitoring
spec:
  project: default
  sources:
    - chart: victoria-metrics-single
      repoURL: https://victoriametrics.github.io/helm-charts
      targetRevision: 0.37.0
      helm:
        releaseName: caretta-vm
        valueFiles:
          - $values/platform/monitoring/caretta/vm-values.yaml

    - repoURL: https://github.com/nyo-infra-study/infrastructure.git
      targetRevision: main
      ref: values

  destination:
    server: https://kubernetes.default.svc
    namespace: monitoring

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
