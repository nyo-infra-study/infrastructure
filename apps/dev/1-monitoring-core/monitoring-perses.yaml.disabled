# ============================================================
# Perses — Dashboard-as-Code (CNCF Sandbox)
# ============================================================
# GitOps-native dashboarding. Dashboards defined as JSON in Git,
# provisioned via ConfigMaps. Points to same backends as Grafana.
# UI: http://perses.localhost
# ============================================================
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "2"
  name: dev-monitoring-perses
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
  labels:
    environment: dev
    domain: monitoring
spec:
  project: default
  sources:
    - chart: perses
      repoURL: https://perses.github.io/helm-charts
      targetRevision: 0.21.0
      helm:
        releaseName: dev-monitoring-perses
        valueFiles:
          - $values/platform/monitoring/perses/values.yaml
    - repoURL: https://github.com/nyo-infra-study/infrastructure.git
      targetRevision: main
      ref: values
  destination:
    server: https://kubernetes.default.svc
    namespace: monitoring
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
---
# --- Perses Resources (Dashboards, Datasources as ConfigMaps) ---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "3"
  name: dev-monitoring-perses-resources
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
  labels:
    environment: dev
    domain: monitoring
spec:
  project: default
  source:
    repoURL: https://github.com/nyo-infra-study/infrastructure.git
    targetRevision: main
    path: platform/monitoring/perses/configmaps
  destination:
    server: https://kubernetes.default.svc
    namespace: monitoring
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
