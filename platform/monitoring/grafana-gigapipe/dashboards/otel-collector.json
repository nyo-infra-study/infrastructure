{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Overview",
      "type": "row"
    },
    {
      "title": "Exported Metrics/s",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval]))", "refId": "A", "instant": true, "legendFormat": "metrics/s" }]
    },
    {
      "title": "Exported Logs/s",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(otelcol_exporter_sent_log_records_total{service_name=\"otel-collector\"}[$__rate_interval]))", "refId": "A", "instant": true, "legendFormat": "logs/s" }]
    },
    {
      "title": "Exported Spans/s",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(otelcol_exporter_sent_spans_total{service_name=\"otel-collector\"}[$__rate_interval]))", "refId": "A", "instant": true, "legendFormat": "spans/s" }]
    },
    {
      "title": "Failed Exports/s",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])) + sum(rate(otelcol_exporter_send_failed_log_records_total{service_name=\"otel-collector\"}[$__rate_interval])) + sum(rate(otelcol_exporter_send_failed_spans_total{service_name=\"otel-collector\"}[$__rate_interval]))", "refId": "A", "instant": true, "legendFormat": "failed/s" }]
    },
    {
      "title": "Queue Size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 100, "color": "yellow" }, { "value": 500, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(otelcol_exporter_queue_size{service_name=\"otel-collector\"})", "refId": "A", "instant": true, "legendFormat": "queued" }]
    },
    {
      "title": "Memory (RSS)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 268435456, "color": "yellow" }, { "value": 419430400, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "otelcol_process_memory_rss_bytes{service_name=\"otel-collector\"}", "refId": "A", "instant": true, "legendFormat": "RSS" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "title": "Exporters — Throughput",
      "type": "row"
    },
    {
      "title": "Exported Metrics (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [{ "expr": "rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{exporter}}" }]
    },
    {
      "title": "Exported Logs (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [{ "expr": "rate(otelcol_exporter_sent_log_records_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{exporter}}" }]
    },
    {
      "title": "Exported Spans (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [{ "expr": "rate(otelcol_exporter_sent_spans_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{exporter}}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "title": "Exporters — Failures & Queue",
      "type": "row"
    },
    {
      "title": "Failed Exports (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "expr": "rate(otelcol_exporter_send_failed_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "metrics {{exporter}}" },
        { "expr": "rate(otelcol_exporter_send_failed_log_records_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "logs {{exporter}}" },
        { "expr": "rate(otelcol_exporter_send_failed_spans_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "C", "legendFormat": "spans {{exporter}}" }
      ]
    },
    {
      "title": "Exporter Queue Size",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "otelcol_exporter_queue_size{service_name=\"otel-collector\"}", "refId": "A", "legendFormat": "{{exporter}}" },
        { "expr": "otelcol_exporter_queue_capacity{service_name=\"otel-collector\"}", "refId": "B", "legendFormat": "capacity {{exporter}}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "title": "Receivers",
      "type": "row"
    },
    {
      "title": "Received Metrics (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 22 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [{ "expr": "rate(otelcol_receiver_accepted_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{receiver}} accepted" }, { "expr": "rate(otelcol_receiver_refused_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "{{receiver}} refused" }]
    },
    {
      "title": "Received Logs (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 22 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [{ "expr": "rate(otelcol_receiver_accepted_log_records_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{receiver}} accepted" }, { "expr": "rate(otelcol_receiver_refused_log_records_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "{{receiver}} refused" }]
    },
    {
      "title": "Received Spans (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [{ "expr": "rate(otelcol_receiver_accepted_spans_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{receiver}} accepted" }, { "expr": "rate(otelcol_receiver_refused_spans_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "{{receiver}} refused" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "title": "Processors",
      "type": "row"
    },
    {
      "title": "Processor Incoming vs Outgoing (metrics)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "rate(otelcol_processor_incoming_items_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "incoming {{processor}}" },
        { "expr": "rate(otelcol_processor_outgoing_items_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "outgoing {{processor}}" }
      ]
    },
    {
      "title": "Processor Dropped (rate/s)",
      "description": "Items dropped by processors. No data = nothing dropped (healthy).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "expr": "rate(otelcol_processor_dropped_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "metrics {{processor}}" },
        { "expr": "rate(otelcol_processor_dropped_log_records_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "logs {{processor}}" },
        { "expr": "rate(otelcol_processor_dropped_spans_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "C", "legendFormat": "spans {{processor}}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "title": "Resources",
      "type": "row"
    },
    {
      "title": "Memory (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 38 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "otelcol_process_memory_rss_bytes{service_name=\"otel-collector\"}", "refId": "A", "legendFormat": "RSS" }]
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 38 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "expr": "rate(otelcol_process_cpu_seconds_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "CPU" }]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 38 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "otelcol_process_uptime_seconds_total{service_name=\"otel-collector\"}", "refId": "A", "instant": true, "legendFormat": "uptime" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "title": "Batch Processor",
      "type": "row"
    },
    {
      "title": "Batch Send Size",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 46 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "rate(otelcol_processor_batch_batch_send_size_sum{service_name=\"otel-collector\"}[$__rate_interval]) / rate(otelcol_processor_batch_batch_send_size_count{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "avg batch size" }
      ]
    },
    {
      "title": "Batch Timeout Triggers/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 46 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "rate(otelcol_processor_batch_timeout_trigger_send_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "timeout triggers/s" },
        { "expr": "rate(otelcol_processor_batch_batch_size_trigger_send_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "size triggers/s" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["otel", "collector", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "OTel Collector",
  "uid": "otel-collector"
}
