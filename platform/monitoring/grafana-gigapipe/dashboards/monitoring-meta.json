    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "title": "PCI Log Sanity Check",
      "type": "row"
    },
    {
      "title": "PCI Log Lines (via selected Loki)",
      "description": "Count of log lines with compliance_scope=pci. Flip the Loki datasource variable to test: PCI should show >0, Non-PCI should show 0.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "uid": "$loki",
        "type": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 (FILTERED \u2713)",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count_over_time({compliance_scope=\"pci\"}[$__range])",
          "refId": "A",
          "instant": true,
          "legendFormat": "pci logs"
        }
      ]
    },
    {
      "title": "Non-PCI Log Lines (via selected Loki)",
      "description": "Count of log lines without PCI scope. Should be visible on both Loki datasources.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 41
      },
      "datasource": {
        "uid": "$loki",
        "type": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count_over_time({compliance_scope!=\"pci\",compliance_scope!=\"\"}[$__range])",
          "refId": "A",
          "instant": true,
          "legendFormat": "non-pci logs"
        }
      ]
    },
    {
      "title": "PCI Filter Status",
      "description": "Shows PASS if the selected Loki datasource correctly hides PCI logs. Switch the Loki dropdown to verify.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 41
      },
      "datasource": {
        "uid": "$loki",
        "type": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 999999999,
                "result": {
                  "text": "PCI LOGS VISIBLE \u26a0\ufe0f",
                  "color": "orange"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "PCI LOGS HIDDEN \u2713",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count_over_time({compliance_scope=\"pci\"}[$__range])",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Logs by compliance_scope",
      "description": "Distribution of log lines by compliance_scope. On Non-PCI Loki, 'pci' should not appear.",
      "type": "piechart",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 41
      },
      "datasource": {
        "uid": "$loki",
        "type": "loki"
      },
      "targets": [
        {
          "expr": "sum by (compliance_scope) (count_over_time({compliance_scope!=\"\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{compliance_scope}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
