{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "Pipeline: Scraped \u2192 Stored \u2192 Queried",
      "type": "row"
    },
    {
      "title": "\u2460 Scraped (raw/s)",
      "description": "Total samples scraped from all targets per second. This is BEFORE filtering.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(scrape_samples_scraped{job=~\"$job\"})",
          "refId": "A",
          "instant": true,
          "legendFormat": "scraped"
        }
      ]
    },
    {
      "title": "\u2461 Stored (rate/s)",
      "description": "Metric points exported by OTel Collector to Gigapipe per second. This is AFTER filtering.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[5m]))",
          "refId": "A",
          "instant": true,
          "legendFormat": "stored"
        }
      ]
    },
    {
      "title": "\u2462 Queried (queries/s)",
      "description": "ClickHouse SELECT queries per second. How much is being read by Grafana/Gigapipe.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_SelectQuery_total{service_name=\"clickhouse\"}[5m])",
          "refId": "A",
          "instant": true,
          "legendFormat": "queries"
        }
      ]
    },
    {
      "title": "Filter Efficiency",
      "description": "Percentage of scraped data that gets dropped by filters. Higher = more aggressive filtering.",
      "type": "gauge",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 0.5,
                "color": "yellow"
              },
              {
                "value": 0.8,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[5m])) / sum(rate(otelcol_processor_incoming_items_total{service_name=\"otel-collector\"}[5m])))",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Scraped by Target",
      "description": "Raw samples each target exposes (pre-filter). High is OK if filter efficiency is good.",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (job) (scrape_samples_scraped{job=~\"$job\"})",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "title": "Stored by Signal (Gigapipe writes/s)",
      "description": "Rows written to ClickHouse per second, by signal type.",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(sent_rows_total[5m])",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
