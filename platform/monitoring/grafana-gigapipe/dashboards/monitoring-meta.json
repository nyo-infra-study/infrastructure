{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "Series & Cardinality",
      "type": "row"
    },
    {
      "title": "Total Active Series",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-pci",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count({__name__=~\".+\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Series by Service",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-pci",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "count by (service_name) ({__name__=~\".+\"})",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "title": "Top 10 Metrics by Series Count",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-pci",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, count by (__name__) ({__name__=~\".+\"}))",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "title": "OTel Collector",
      "type": "row"
    },
    {
      "title": "OTel Collector \u2014 Exported Metrics (rate/s)",
