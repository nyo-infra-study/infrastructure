        "uid": "prometheus-pci",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[5m])",
          "refId": "A",
          "legendFormat": "metrics/s"
        }
      ]
    },
    {
