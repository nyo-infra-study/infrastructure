{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Pipeline Overview",
      "type": "row"
    },
    {
      "title": "Data Volume by Signal",
      "description": "Namespace (big box) → Service (small box inside). Size = bytes written.",
      "type": "marcusolsson-treemap-panel",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "sum by (namespace, service) (sent_bytes_total{job=~\"$instance\"})", "refId": "A", "instant": true, "legendFormat": "{{namespace}}/{{service}}", "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": {
        "tiling": "treemapSquarify",
        "textField": "label",
        "sizeField": "Value",
        "separator": "/"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "namespace": true, "service": true },
            "renameByName": {}
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.+)",
            "renamePattern": "$1"
          }
        }
      ]
    },
    {
      "title": "Component Health",
      "description": "At-a-glance health of all observability components. Green = healthy, Red = down.",
      "type": "grafana-polystat-panel",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "up{job=~\"otel-collector|clickhouse|gigapipe.*\"}", "refId": "A", "instant": true, "legendFormat": "{{job}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] }
        },
        "overrides": []
      }
    },
    {
      "title": "① Scraped (raw/s)",
      "description": "Total samples scraped from all targets per second. BEFORE filtering.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 9 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "yellow" } }, "overrides": [] },
      "targets": [{ "expr": "sum(scrape_samples_scraped{job=~\"$job\"})", "refId": "A", "instant": true }]
    },
    {
      "title": "② Stored (rate/s)",
      "description": "Metric points exported by OTel Collector to Gigapipe per second. AFTER filtering.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 9 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[5m]))", "refId": "A", "instant": true }]
    },
    {
      "title": "③ Queried (queries/s)",
      "description": "ClickHouse SELECT queries per second.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 9 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [{ "expr": "rate(ClickHouseProfileEvents_SelectQuery_total{service_name=\"clickhouse\"}[5m])", "refId": "A", "instant": true }]
    },
    {
      "title": "Filter Efficiency",
      "description": "Percentage of scraped data dropped by filters. Higher = more aggressive filtering.",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 9 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 0.5, "color": "yellow" }, { "value": 0.8, "color": "green" }] } }, "overrides": [] },
      "targets": [{ "expr": "1 - (sum(rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[5m])) / sum(rate(otelcol_processor_incoming_items_total{service_name=\"otel-collector\"}[5m])))", "refId": "A", "instant": true }]
    },
    {
      "title": "CH Active Parts",
      "description": "ClickHouse active parts count. High = merge pressure.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 9 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 500, "color": "yellow" }, { "value": 1000, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "ClickHouseMetrics_PartsActive{job=\"clickhouse\"}", "refId": "A", "instant": true }]
    },
    {
      "title": "CH Memory",
      "description": "ClickHouse memory tracking.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 9 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1073741824, "color": "yellow" }, { "value": 2147483648, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "ClickHouseMetrics_MemoryTracking{job=\"clickhouse\"}", "refId": "A", "instant": true }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "title": "OTel Collector",
      "type": "row"
    },
    {
      "title": "OTel — Exported by Signal (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "metrics/s" },
        { "expr": "rate(otelcol_exporter_sent_log_records_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "logs/s" },
        { "expr": "rate(otelcol_exporter_sent_spans_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "C", "legendFormat": "spans/s" }
      ]
    },
    {
      "title": "OTel — Failed & Dropped (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "expr": "rate(otelcol_exporter_send_failed_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "failed metrics" },
        { "expr": "rate(otelcol_exporter_send_failed_log_records_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "failed logs" },
        { "expr": "rate(otelcol_exporter_send_failed_spans_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "C", "legendFormat": "failed spans" }
      ]
    },
    {
      "title": "OTel — Queue Size & Capacity",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 21 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "otelcol_exporter_queue_size{service_name=\"otel-collector\"}", "refId": "A", "legendFormat": "queue {{exporter}}" },
        { "expr": "otelcol_exporter_queue_capacity{service_name=\"otel-collector\"}", "refId": "B", "legendFormat": "capacity {{exporter}}" }
      ]
    },
    {
      "title": "OTel — Processor In vs Out",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 21 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "rate(otelcol_processor_incoming_items_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "A", "legendFormat": "in {{processor}}" },
        { "expr": "rate(otelcol_processor_outgoing_items_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "out {{processor}}" }
      ]
    },
    {
      "title": "OTel — Memory & CPU",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 21 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [{ "matcher": { "id": "byName", "options": "CPU" }, "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "custom.axisPlacement", "value": "right" }] }] },
      "targets": [
        { "expr": "otelcol_process_memory_rss_bytes{service_name=\"otel-collector\"}", "refId": "A", "legendFormat": "RSS" },
        { "expr": "rate(otelcol_process_cpu_seconds_total{service_name=\"otel-collector\"}[$__rate_interval])", "refId": "B", "legendFormat": "CPU" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "title": "Gigapipe",
      "type": "row"
    },
    {
      "title": "Gigapipe — Rows Written/s by Signal",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [{ "expr": "rate(sent_rows_total{job=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{service}}" }]
    },
    {
      "title": "Gigapipe — Bytes Written/s by Signal",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [{ "expr": "rate(sent_bytes_total{job=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{service}}" }]
    },
    {
      "title": "Gigapipe — Send Time (ms)",
      "description": "Time spent sending batch to ClickHouse.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 36 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [{ "expr": "rate(send_time_ms_sum{job=~\"$instance\"}[$__rate_interval]) / rate(send_time_ms_count{job=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "avg send time" }]
    },
    {
      "title": "Gigapipe — Memory (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 36 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "process_resident_memory_bytes{job=~\"$instance\"}", "refId": "A", "legendFormat": "{{job}}" }]
    },
    {
      "title": "Gigapipe — Connection Resets",
      "description": "Connection reset by peer errors.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 36 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [{ "expr": "rate(connection_reset_by_peer_count_total{job=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "resets/s" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "title": "ClickHouse (Summary)",
      "type": "row"
    },
    {
      "title": "CH — Queries/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 44 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "rate(ClickHouseProfileEvents_SelectQuery_total{job=\"clickhouse\"}[5m])", "refId": "A", "legendFormat": "selects/s" },
        { "expr": "rate(ClickHouseProfileEvents_InsertQuery_total{job=\"clickhouse\"}[5m])", "refId": "B", "legendFormat": "inserts/s" }
      ]
    },
    {
      "title": "CH — Inserted Rows/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 44 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [{ "expr": "rate(ClickHouseProfileEvents_InsertedRows_total{job=\"clickhouse\"}[5m])", "refId": "A", "legendFormat": "rows/s" }]
    },
    {
      "title": "CH — Active Parts & Merges",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 44 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        { "expr": "ClickHouseMetrics_PartsActive{job=\"clickhouse\"}", "refId": "A", "legendFormat": "active parts" },
        { "expr": "ClickHouseMetrics_Merge{job=\"clickhouse\"}", "refId": "B", "legendFormat": "running merges" }
      ]
    },
    {
      "title": "CH — Memory & Disk I/O",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 51 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "ClickHouseMetrics_MemoryTracking{job=\"clickhouse\"}", "refId": "A", "legendFormat": "memory" }
      ]
    },
    {
      "title": "CH — Failed Queries/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 51 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "expr": "rate(ClickHouseProfileEvents_FailedQuery_total{job=\"clickhouse\"}[5m])", "refId": "A", "legendFormat": "failed queries/s" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "title": "PCI Log Sanity Check",
      "type": "row"
    },
    {
      "title": "PCI Log Lines (via selected Loki)",
      "description": "Count of log lines with compliance_scope=pci. Flip the Loki datasource variable to test.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 59 },
      "datasource": { "uid": "$loki", "type": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "orange" }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "0 (FILTERED ✓)", "color": "green" } } }] }, "overrides": [] },
      "targets": [{ "expr": "count_over_time({compliance_scope=\"pci\"}[$__range])", "refId": "A", "instant": true }]
    },
    {
      "title": "Non-PCI Log Lines",
      "description": "Count of log lines without PCI scope. Should be visible on both Loki datasources.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 59 },
      "datasource": { "uid": "$loki", "type": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [{ "expr": "count_over_time({compliance_scope!=\"pci\",compliance_scope!=\"\"}[$__range])", "refId": "A", "instant": true }]
    },
    {
      "title": "PCI Filter Status",
      "description": "PASS if selected Loki datasource correctly hides PCI logs.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 59 },
      "datasource": { "uid": "$loki", "type": "loki" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "range", "options": { "from": 1, "to": 999999999, "result": { "text": "PCI LOGS VISIBLE ⚠️", "color": "orange" } } }, { "type": "value", "options": { "0": { "text": "PCI LOGS HIDDEN ✓", "color": "green" } } }] }, "overrides": [] },
      "targets": [{ "expr": "count_over_time({compliance_scope=\"pci\"}[$__range])", "refId": "A", "instant": true }]
    },
    {
      "title": "Logs by compliance_scope",
      "description": "Distribution of log lines by compliance_scope.",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 59 },
      "datasource": { "uid": "$loki", "type": "loki" },
      "targets": [{ "expr": "sum by (compliance_scope) (count_over_time({compliance_scope!=\"\"}[$__range]))", "refId": "A", "instant": true, "legendFormat": "{{compliance_scope}}" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["monitoring", "meta", "observability", "gigapipe", "otel", "clickhouse"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "uid": "prometheus", "type": "prometheus" },
        "definition": "label_values(up, job)",
        "hide": 0,
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(up, job)" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "uid": "prometheus", "type": "prometheus" },
        "definition": "label_values(sent_rows_total, job)",
        "hide": 0,
        "includeAll": true,
        "label": "Gigapipe Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(sent_rows_total, job)" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "Loki (PCI)", "value": "loki-pci" },
        "hide": 0,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Observability Stack",
  "uid": "monitoring-meta"
}
