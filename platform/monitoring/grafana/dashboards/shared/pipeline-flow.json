    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "title": "Filter Details (per processor)",
      "type": "row"
    },
    {
      "title": "Data Dropped by Processor (rate/s)",
      "description": "How many data points each OTel processor drops per second. Only processors that actively remove data appear.",
      "type": "barchart",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (processor) (rate(otelcol_processor_incoming_items_total{service_name=\"otel-collector\"}[$__rate_interval]) - rate(otelcol_processor_outgoing_items_total{service_name=\"otel-collector\"}[$__rate_interval])) > 0",
          "refId": "A",
          "range": true,
          "legendFormat": "{{processor}}",
