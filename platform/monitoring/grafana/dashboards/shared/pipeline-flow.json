      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xField": "processor",
        "stacking": "none"
      },
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "processor": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Value": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
