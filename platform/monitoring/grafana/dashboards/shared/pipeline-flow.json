{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "Pipeline Overview: Raw Scrape → Scrape Filter → Processor Filter → Gigapipe",
      "type": "row"
    },
    {
      "title": "① Raw Scraped by Job (samples/s)",
      "description": "Total samples scraped from each job BEFORE scrape-level metric_relabel_configs. This is the raw volume from targets.",
      "type": "barchart",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (job) (scrape_samples_scraped)",
          "refId": "A",
          "range": true,
          "legendFormat": "{{job}}",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xField": "job",
        "stacking": "none",
        "barWidth": 0.7
      },
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "job": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Value": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value (lastNotNull)": "samples/s"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "samples/s",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "title": "② After Scrape Filter by Receiver (pts/s)",
      "description": "Metric points accepted by OTel Collector per receiver. This is AFTER Prometheus metric_relabel_configs but BEFORE OTel processor filters.",
      "type": "barchart",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (receiver) (rate(otelcol_receiver_accepted_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "legendFormat": "{{receiver}}",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xField": "receiver",
        "stacking": "none",
        "barWidth": 0.7
      },
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "receiver": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Value": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value (lastNotNull)": "pts/s"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "pts/s",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "title": "③ After Processor Filter (pts/s)",
      "description": "Final output of OTel processor filters: what reaches Gigapipe vs what gets discarded.",
      "type": "barchart",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "label_replace(sum(rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])), \"outcome\", \"→ gigapipe\", \"\", \"\") or label_replace(sum(rate(otelcol_processor_incoming_items_total{service_name=\"otel-collector\"}[$__rate_interval])) - sum(rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])), \"outcome\", \"→ discarded\", \"\", \"\")",
          "refId": "A",
          "range": true,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "→ gigapipe"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "→ discarded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xField": "outcome",
        "stacking": "none",
        "barWidth": 0.5
      },
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "outcome": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Value": {
                "aggregations": ["lastNotNull"],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value (lastNotNull)": "pts/s"
            }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "title": "Filter Efficiency",
      "type": "row"
    },
    {
      "title": "Scrape Filter Efficiency",
      "description": "How much Prometheus metric_relabel_configs drops at scrape time. Compares raw scraped samples vs what OTel receives.",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(otelcol_receiver_accepted_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])) / sum(scrape_samples_scraped))",
          "refId": "A",
          "legendFormat": "scrape filter",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "Processor Filter Efficiency",
      "description": "How much OTel processor filters drop. Compares what enters processors vs what gets exported.",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(otelcol_exporter_sent_metric_points_total{service_name=\"otel-collector\"}[$__rate_interval])) / sum(rate(otelcol_processor_incoming_items_total{service_name=\"otel-collector\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "processor filter",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "Total Raw Scraped",
      "description": "Sum of all raw samples scraped from all targets (before any filtering).",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(scrape_samples_scraped)",
          "refId": "A",
          "legendFormat": "raw",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Into OTel (pts/s)",
