{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Storage",
      "type": "row"
    },
    {
      "title": "Total Data Size",
      "description": "Actual compressed data stored in all MergeTree tables (user data, not filesystem).",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [
        {
          "expr": "ClickHouseAsyncMetrics_TotalBytesOfMergeTreeTables{job=\"clickhouse\"} - ClickHouseAsyncMetrics_TotalBytesOfMergeTreeTablesSystem{job=\"clickhouse\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "data size"
        }
      ]
    },
    {
      "title": "Total Parts",
      "description": "Number of active data parts. High count may indicate merge pressure.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "targets": [
        {
          "expr": "ClickHouseMetrics_PartsActive{job=\"clickhouse\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "active parts"
        }
      ]
    },
    {
      "title": "Total Rows",
      "description": "Total rows stored across all tables.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [
        {
          "expr": "ClickHouseAsyncMetrics_TotalRowsOfMergeTreeTables{job=\"clickhouse\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "rows"
        }
      ]
    },
    {
      "title": "Memory Tracking",
      "description": "Current memory used by ClickHouse server.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 1073741824, "color": "yellow" }, { "value": 2147483648, "color": "red" } ] } }, "overrides": [] },
      "targets": [
        {
          "expr": "ClickHouseMetrics_MemoryTracking{job=\"clickhouse\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "memory"
        }
      ]
    },
    {
      "title": "Data Size Over Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "ClickHouseAsyncMetrics_TotalBytesOfMergeTreeTables{job=\"clickhouse\"} - ClickHouseAsyncMetrics_TotalBytesOfMergeTreeTablesSystem{job=\"clickhouse\"}",
          "refId": "A",
          "legendFormat": "user data"
        },
        {
          "expr": "ClickHouseAsyncMetrics_TotalBytesOfMergeTreeTablesSystem{job=\"clickhouse\"}",
          "refId": "B",
          "legendFormat": "system data"
        }
      ]
    },
    {
      "title": "Active Parts Over Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "ClickHouseMetrics_PartsActive{job=\"clickhouse\"}",
          "refId": "A",
          "legendFormat": "active parts"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "title": "Queries",
      "type": "row"
    },
    {
      "title": "Queries/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_Query_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "all queries/s"
        },
        {
          "expr": "rate(ClickHouseProfileEvents_SelectQuery_total{job=\"clickhouse\"}[5m])",
          "refId": "B",
          "legendFormat": "selects/s"
        },
        {
          "expr": "rate(ClickHouseProfileEvents_InsertQuery_total{job=\"clickhouse\"}[5m])",
          "refId": "C",
          "legendFormat": "inserts/s"
        }
      ]
    },
    {
      "title": "Failed Queries/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_FailedQuery_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "failed queries/s"
        },
        {
          "expr": "rate(ClickHouseProfileEvents_FailedSelectQuery_total{job=\"clickhouse\"}[5m])",
          "refId": "B",
          "legendFormat": "failed selects/s"
        },
        {
          "expr": "rate(ClickHouseProfileEvents_FailedInsertQuery_total{job=\"clickhouse\"}[5m])",
          "refId": "C",
          "legendFormat": "failed inserts/s"
        }
      ]
    },
    {
      "title": "Current Running Queries",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 10, "color": "yellow" }, { "value": 50, "color": "red" } ] } }, "overrides": [] },
      "targets": [
        {
          "expr": "ClickHouseMetrics_Query{job=\"clickhouse\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "running"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "title": "Inserts",
      "type": "row"
    },
    {
      "title": "Inserted Rows/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_InsertedRows_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "rows/s"
        }
      ]
    },
    {
      "title": "Inserted Bytes/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_InsertedBytes_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "bytes/s"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "title": "Merges & Background",
      "type": "row"
    },
    {
      "title": "Background Merges Running",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 30 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "ClickHouseMetrics_Merge{job=\"clickhouse\"}",
          "refId": "A",
          "legendFormat": "merges"
        }
      ]
    },
    {
      "title": "Merged Rows/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 30 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_MergedRows_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "merged rows/s"
        }
      ]
    },
    {
      "title": "Merged Bytes/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 30 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_MergedUncompressedBytes_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "merged bytes/s"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "title": "Connections & Resources",
      "type": "row"
    },
    {
      "title": "TCP Connections",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 38 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "ClickHouseMetrics_TCPConnection{job=\"clickhouse\"}",
          "refId": "A",
          "legendFormat": "TCP connections"
        },
        {
          "expr": "ClickHouseMetrics_HTTPConnection{job=\"clickhouse\"}",
          "refId": "B",
          "legendFormat": "HTTP connections"
        }
      ]
    },
    {
      "title": "Memory Over Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 38 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "ClickHouseMetrics_MemoryTracking{job=\"clickhouse\"}",
          "refId": "A",
          "legendFormat": "memory tracking"
        }
      ]
    },
    {
      "title": "Read/Write Bytes/s (Disk I/O)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 38 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_ReadBufferFromFileDescriptorReadBytes_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "read bytes/s"
        },
        {
          "expr": "rate(ClickHouseProfileEvents_WriteBufferFromFileDescriptorWriteBytes_total{job=\"clickhouse\"}[5m])",
          "refId": "B",
          "legendFormat": "write bytes/s"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "title": "ZooKeeper / Keeper",
      "type": "row"
    },
    {
      "title": "ZooKeeper Requests/s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 46 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_ZooKeeperTransactions_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "transactions/s"
        },
        {
          "expr": "rate(ClickHouseProfileEvents_ZooKeeperGet_total{job=\"clickhouse\"}[5m])",
          "refId": "B",
          "legendFormat": "gets/s"
        }
      ]
    },
    {
      "title": "ZooKeeper Wait Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 46 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "µs" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_ZooKeeperWaitMicroseconds_total{job=\"clickhouse\"}[5m])",
          "refId": "A",
          "legendFormat": "wait µs/s"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
      "title": "Active Queries (searchable)",
      "type": "row"
    },
    {
      "title": "ClickHouse Metrics Overview",
      "description": "All ClickHouse metrics with current values. Use the search box to find a specific metric.",
      "type": "briangann-datatable-panel",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 54 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "{__name__=~\"ClickHouseMetrics_.+\",job=\"clickhouse\"} > 0",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true, "instance": true },
            "renameByName": { "__name__": "Metric", "Value": "Value" }
          }
        }
      ],
      "options": {
        "showSearchFilter": true,
        "searchEnabled": true,
        "searchHighlightingEnabled": true,
        "searchPosition": "top-right",
        "rowNumbersEnabled": true,
        "scrollingEnabled": true,
        "columnStylesConfig": [
          {
            "label": "Value",
            "nameOrRegex": "Value",
            "activeStyle": "metric",
            "enabled": true,
            "order": 0,
            "align": "default",
            "metricStyle": {
              "alias": "",
              "thresholds": [],
              "colors": [],
              "decimals": "0",
              "scaledDecimals": null,
              "unitFormat": "short",
              "ignoreNullValues": true
            },
            "dateStyle": { "dateFormat": "YYYY-MM-DD HH:mm:ss" },
            "hiddenStyle": {},
            "stringStyle": {
              "clickThrough": "",
              "clickThroughSanitize": true,
              "clickThroughOpenNewTab": true,
              "clickThroughCustomTarget": "",
              "splitByPattern": "",
              "mappingType": 1
            }
          }
        ]
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "clickhouse",
    "storage",
    "observability"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "ClickHouse",
  "uid": "clickhouse"
}
