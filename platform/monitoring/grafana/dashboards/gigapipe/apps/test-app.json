{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Overview",
      "type": "row"
    },
    {
      "title": "Request Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\"}[$__rate_interval]))", "refId": "A", "instant": true }]
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 0.1, "color": "yellow" }, { "value": 1, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))", "refId": "A", "instant": true }]
    },
    {
      "title": "Error %",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 0.01, "color": "yellow" }, { "value": 0.05, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\"}[$__rate_interval]))", "refId": "A", "instant": true }]
    },
    {
      "title": "P50",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])) by (le))", "refId": "A", "instant": true }]
    },
    {
      "title": "P95",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 0.5, "color": "yellow" }, { "value": 2, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])) by (le))", "refId": "A", "instant": true }]
    },
    {
      "title": "P99",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 5, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])) by (le))", "refId": "A", "instant": true }]
    },
    {
      "title": "Pods Running",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [{ "expr": "count(kube_pod_status_phase{phase=\"Running\",pod=~\"$service.*\"})", "refId": "A", "instant": true }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "title": "RED Metrics",
      "type": "row"
    },
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\"}[$__rate_interval]))", "refId": "A", "legendFormat": "requests" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))", "refId": "A", "legendFormat": "errors" },
        { "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\",status_code=\"STATUS_CODE_OK\"}[$__rate_interval]))", "refId": "B", "legendFormat": "ok" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "Duration (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])) by (le))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])) by (le))", "refId": "C", "legendFormat": "p99" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "title": "By Operation",
      "type": "row"
    },
    {
      "title": "Request Rate by Operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service_name=\"$service\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{span_name}}" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "sortBy": "Last *", "sortDesc": true } }
    },
    {
      "title": "P95 Duration by Operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (span_name, le) (rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])))", "refId": "A", "legendFormat": "{{span_name}}" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "sortBy": "Last *", "sortDesc": true } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "title": "Resources",
      "type": "row"
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"$service.*\",container!=\"\",container!=\"POD\"}[$__rate_interval]))", "refId": "A", "legendFormat": "usage" },
        { "expr": "sum(kube_pod_container_resource_requests{pod=~\"$service.*\",resource=\"cpu\"})", "refId": "B", "legendFormat": "request" },
        { "expr": "sum(kube_pod_container_resource_limits{pod=~\"$service.*\",resource=\"cpu\"})", "refId": "C", "legendFormat": "limit" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{pod=~\"$service.*\",container!=\"\",container!=\"POD\"})", "refId": "A", "legendFormat": "working set" },
        { "expr": "sum(kube_pod_container_resource_requests{pod=~\"$service.*\",resource=\"memory\"})", "refId": "B", "legendFormat": "request" },
        { "expr": "sum(kube_pod_container_resource_limits{pod=~\"$service.*\",resource=\"memory\"})", "refId": "C", "legendFormat": "limit" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "title": "Traces",
      "type": "row"
    },
    {
      "title": "Recent Traces",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "datasource": { "uid": "$ds_tempo", "type": "tempo" },
      "targets": [{
        "queryType": "traceql",
        "refId": "A",
        "query": "{resource.service.name=\"$service\" && duration > ${min_duration}}",
        "limit": 20,
        "tableType": "traces"
      }],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Start time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Duration" }, "properties": [{ "id": "unit", "value": "ms" }] }
        ]
      }
    },
    {
      "title": "Error Traces",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 41 },
      "datasource": { "uid": "$ds_tempo", "type": "tempo" },
      "targets": [{
        "queryType": "traceql",
        "refId": "A",
        "query": "{resource.service.name=\"$service\" && .http.response.status_code=~\"4..|5..\"}",
        "limit": 20,
        "tableType": "traces"
      }],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Start time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Duration" }, "properties": [{ "id": "unit", "value": "ms" }] }
        ]
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "title": "Logs",
      "type": "row"
    },
    {
      "title": "Application Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 50 },
      "datasource": { "uid": "$ds_loki", "type": "loki" },
      "targets": [{ "expr": "{service_name=~\"$service\"}", "refId": "A" }],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["service", "RED", "app"],
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "label": "Prometheus"
      },
      {
        "name": "ds_tempo",
        "type": "datasource",
        "query": "tempo",
        "current": { "text": "Tempo", "value": "tempo" },
        "label": "Tempo"
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki (PCI)", "value": "loki-pci" },
        "label": "Loki"
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "uid": "$ds_prometheus", "type": "prometheus" },
        "query": "label_values(traces_spanmetrics_calls_total, service_name)",
        "multi": false,
        "includeAll": false,
        "current": { "text": "test-app", "value": "test-app" },
        "refresh": 2
      },
      {
        "name": "min_duration",
        "type": "custom",
        "query": "0ms,10ms,50ms,100ms,250ms,500ms,1s,2s,5s",
        "current": { "text": "0ms", "value": "0ms" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Service: test-app",
  "uid": "service-test-app"
}
